{
  "info": {
    "name": "DKat PBI 46",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "sku",
      "value": "DKAT-DEMO-A"
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Phân trang",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/products?page=1&size=5&sort=-name"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.response.to.have.status(200);"
            ]
          }
        }
      ]
    },
    {
      "name": "Tìm theo SKU",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/products?keyword={{sku}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.response.to.have.status(200);",
              "const product = pm.response.json().find(row => row.variants.some(v => v.sku === pm.collectionVariables.get('sku')));",
              "pm.expect(product).to.exist;",
              "if (product) pm.collectionVariables.set('productId', product.product_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Chi tiết",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.response.to.have.status(200);"
            ]
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  }
}
