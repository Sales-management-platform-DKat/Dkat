{
  "info": {
    "name": "DKat PBI 83 | Lịch sử biến động kho",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Chạy trên database kiểm thử, điền accessToken của OWNER, branchId và variantId đã có dòng tồn kho. Luồng tạo ba biến động và đưa số lượng trở về tồn ban đầu. Chạy đúng thứ tự và tránh cập nhật đồng thời biến thể thử nghiệm."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "branchId",
      "value": ""
    },
    {
      "key": "variantId",
      "value": ""
    },
    {
      "key": "initialQuantity",
      "value": ""
    },
    {
      "key": "importId",
      "value": ""
    },
    {
      "key": "exportId",
      "value": ""
    },
    {
      "key": "adjustmentId",
      "value": ""
    },
    {
      "key": "exportTimestamp",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Movement history",
      "item": [
        {
          "name": "Lấy tồn thực ban đầu",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/inventory/{{branchId}}/{{variantId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Kiểm tra phản hồi', () => {",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.branchId).to.eql(Number(pm.variables.get('branchId')));",
                  "  pm.expect(data.quantity).to.be.at.least(data.reserved);",
                  "  pm.collectionVariables.set('initialQuantity', data.quantity);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Nhập 3 đơn vị",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/inventory/import",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branchId\": {{branchId}},\n  \"note\": \"Kiểm thử PBI 83\",\n  \"items\": [\n    {\n      \"variantId\": {{variantId}},\n      \"quantity\": 3\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Kiểm tra phản hồi', () => {",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.movementType).to.eql('IMPORT');",
                  "  pm.expect(data.items).to.have.lengthOf(1);",
                  "  pm.expect(data.items[0].quantityChange).to.eql(3);",
                  "  pm.collectionVariables.set('importId', data.items[0].movementId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Xuất 1 đơn vị",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/inventory/export",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branchId\": {{branchId}},\n  \"note\": \"Kiểm thử PBI 83\",\n  \"items\": [\n    {\n      \"variantId\": {{variantId}},\n      \"quantity\": 1\n    }\n  ],\n  \"reason\": \"MAU\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Kiểm tra phản hồi', () => {",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.movementType).to.eql('EXPORT');",
                  "  pm.expect(data.items).to.have.lengthOf(1);",
                  "  pm.expect(data.items[0].quantityChange).to.eql(-1);",
                  "  pm.collectionVariables.set('exportId', data.items[0].movementId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Kiểm kê về số ban đầu",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/inventory/stocktake",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branchId\": {{branchId}},\n  \"note\": \"Kiểm thử PBI 83\",\n  \"items\": [\n    {\n      \"variantId\": {{variantId}},\n      \"countedQuantity\": {{initialQuantity}}\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Kiểm tra phản hồi', () => {",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.movementType).to.eql('ADJUSTMENT');",
                  "  pm.expect(data.items).to.have.lengthOf(1);",
                  "  pm.expect(data.items[0].quantityChange).to.eql(-2);",
                  "  pm.collectionVariables.set('adjustmentId', data.items[0].movementId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Xem đủ ba biến động mới nhất",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/inventory/movements?branchId={{branchId}}&variantId={{variantId}}&size=3"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Kiểm tra phản hồi', () => {",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.map(row => row.movementId)).to.eql([Number(pm.variables.get('adjustmentId')), Number(pm.variables.get('exportId')), Number(pm.variables.get('importId'))]);",
                  "  pm.expect(data.map(row => row.quantityChange)).to.eql([-2, -1, 3]);",
                  "  data.forEach(row => {",
                  "    pm.expect(row).to.include.keys('createdBy', 'createdByName', 'referenceType', 'referenceId', 'createdAt', 'sku');",
                  "    pm.expect(row.note).to.eql('Kiểm thử PBI 83');",
                  "  });",
                  "  pm.expect(data[1].exportReason).to.eql('MAU');",
                  "  pm.collectionVariables.set('exportTimestamp', encodeURIComponent(data[1].createdAt));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Lọc theo loại và thời điểm",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/inventory/movements?branchId={{branchId}}&variantId={{variantId}}&type=EXPORT&from={{exportTimestamp}}&to={{exportTimestamp}}&size=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Kiểm tra phản hồi', () => {",
                  "  const data = pm.response.json();",
                  "  pm.expect(data).to.have.lengthOf(1);",
                  "  pm.expect(data[0].movementId).to.eql(Number(pm.variables.get('exportId')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Phân trang",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/inventory/movements?branchId={{branchId}}&variantId={{variantId}}&page=2&size=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Kiểm tra phản hồi', () => {",
                  "  const data = pm.response.json();",
                  "  pm.expect(data).to.have.lengthOf(1);",
                  "  pm.expect(data[0].movementId).to.eql(Number(pm.variables.get('exportId')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Từ chối khoảng ngày đảo ngược",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/inventory/movements?branchId={{branchId}}&variantId={{variantId}}&from=2026-11-18&to=2026-11-17"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 422', () => pm.response.to.have.status(422));",
                  "pm.test('Kiểm tra phản hồi', () => {",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.detail).to.be.an('array').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Từ chối thiếu token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/inventory/movements?branchId={{branchId}}&variantId={{variantId}}",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('Kiểm tra phản hồi', () => {",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.detail).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
