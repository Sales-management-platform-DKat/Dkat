{
  "info": {
    "name": "DKat - Public catalog (FR-07)",
    "description": "Không cần đăng nhập. Cần seed: python -m scripts.seed_auth && python -m scripts.seed_catalog. Giới hạn 60 request/phút/IP: chạy collection nhiều lần liên tiếp có thể nhận 429.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Cây danh mục (không đăng nhập)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/public/categories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "public",
            "categories"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Không có trường nội bộ (giá vốn, tồn, SKU, mã, chi nhánh, trạng thái...)\", () => pm.expect(pm.response.text()).to.not.match(/cost|123456|quantity|reserved|allocated|sku|SP-MAU|productCode|barcode|storeId|branch|created|status|password/i));",
              "const tree = pm.response.json().data; const byName = {}; const walk = (ns) => ns.forEach(n => { byName[n.name] = n.id; walk(n.children); }); walk(tree);",
              "pm.test(\"Có Thời trang > Áo, Quần\", () => pm.expect(tree.find(n => n.name === \"Thời trang\").children.map(c => c.name)).to.eql([\"Áo\", \"Quần\"]));",
              "pm.test(\"Ẩn Ngừng kinh doanh và nhánh con\", () => { pm.expect(byName).to.not.have.property(\"Ngừng kinh doanh\"); pm.expect(byName).to.not.have.property(\"Hàng thanh lý\"); });",
              "pm.collectionVariables.set(\"catFashion\", byName[\"Thời trang\"]); pm.collectionVariables.set(\"catShirt\", byName[\"Áo\"]);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Tất cả sản phẩm (không đăng nhập)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/public/products?size=50",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "public",
            "products"
          ],
          "query": [
            {
              "key": "size",
              "value": "50"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Không có trường nội bộ (giá vốn, tồn, SKU, mã, chi nhánh, trạng thái...)\", () => pm.expect(pm.response.text()).to.not.match(/cost|123456|quantity|reserved|allocated|sku|SP-MAU|productCode|barcode|storeId|branch|created|status|password/i));",
              "const items = pm.response.json().data.items;",
              "pm.test(\"Đúng các trường công khai\", () => items.forEach(p => pm.expect(p).to.have.keys(\"id\", \"name\", \"imageUrl\", \"category\", \"priceMin\", \"priceMax\", \"inStock\")));",
              "const shirt = items.find(p => p.name === \"Áo sơ mi mẫu\");",
              "pm.test(\"Khoảng giá 250000 - 280000\", () => { pm.expect(shirt.priceMin).to.eql(250000); pm.expect(shirt.priceMax).to.eql(280000); });",
              "pm.test(\"Quần kaki mẫu hết hàng khả dụng\", () => pm.expect(items.find(p => p.name === \"Quần kaki mẫu\").inStock).to.eql(false));",
              "pm.test(\"Không có sản phẩm INACTIVE / danh mục ẩn\", () => { const n = items.map(p => p.name); pm.expect(n).to.not.include(\"Áo ngừng bán mẫu\"); pm.expect(n).to.not.include(\"Áo thanh lý mẫu\"); });",
              "pm.collectionVariables.set(\"shirtId\", shirt.id); pm.collectionVariables.set(\"pantsId\", items.find(p => p.name === \"Quần kaki mẫu\").id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2a. Chi nhánh ACTIVE (không đăng nhập)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/public/branches",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "public",
            "branches"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const list = pm.response.json().data;",
              "pm.test(\"Chỉ id, name, address, phone\", () => list.forEach(b => pm.expect(b).to.have.keys(\"id\", \"name\", \"address\", \"phone\")));",
              "pm.test(\"Có Quận 1, Cầu Giấy, Hải Châu\", () => { const n = list.map(b => b.name); [\"Chi nhánh Quận 1\", \"Chi nhánh Cầu Giấy\", \"Chi nhánh Hải Châu\"].forEach(x => pm.expect(n).to.include(x)); });",
              "pm.test(\"Không lộ trường nội bộ\", () => pm.expect(pm.response.text()).to.not.match(/status|storeId|branchCode|created|CN0/i));",
              "pm.collectionVariables.set(\"branchIds\", JSON.stringify(list.map(b => b.id).sort((a, b) => a - b)));",
              "pm.collectionVariables.set(\"cauGiayId\", list.find(b => b.name === \"Chi nhánh Cầu Giấy\").id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2b. Chi tiết Áo sơ mi mẫu (trang chi tiết + form đặt trước)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/public/products/{{shirtId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "public",
            "products",
            "{{shirtId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const d = pm.response.json().data; const ids = JSON.parse(pm.collectionVariables.get(\"branchIds\"));",
              "pm.test(\"Có tên, mô tả, ảnh, danh mục, giá, biến thể\", () => pm.expect(d).to.have.keys(\"id\", \"name\", \"description\", \"imageUrl\", \"category\", \"priceMin\", \"priceMax\", \"inStock\", \"variants\"));",
              "pm.test(\"Biến thể: id, sku, name, price, attributes, branches\", () => d.variants.forEach(v => pm.expect(v).to.have.keys(\"id\", \"sku\", \"name\", \"price\", \"attributes\", \"branches\")));",
              "pm.test(\"Chỉ biến thể ACTIVE\", () => pm.expect(d.variants.map(v => v.sku).sort()).to.eql([\"SP-MAU-02-DO-L\", \"SP-MAU-02-XANH-M\"]));",
              "pm.test(\"Mỗi biến thể đủ chi nhánh ACTIVE, chỉ IN_STOCK/OUT_OF_STOCK\", () => d.variants.forEach(v => { pm.expect(v.branches.map(b => b.branchId).sort((a, b) => a - b)).to.eql(ids); v.branches.forEach(b => pm.expect([\"IN_STOCK\", \"OUT_OF_STOCK\"]).to.include(b.availability)); }));",
              "const xanh = d.variants.find(v => v.sku === \"SP-MAU-02-XANH-M\"); const inStock = xanh.branches.filter(b => b.availability === \"IN_STOCK\").map(b => b.branchId);",
              "pm.test(\"Xanh M chỉ còn ở Cầu Giấy\", () => pm.expect(inStock).to.eql([Number(pm.collectionVariables.get(\"cauGiayId\"))]));",
              "pm.test(\"Thuộc tính Màu Xanh, Size M\", () => pm.expect(xanh.attributes).to.eql([{name: \"Màu\", value: \"Xanh\"}, {name: \"Size\", value: \"M\"}]));",
              "pm.test(\"Không lộ giá vốn / số lượng / trạng thái nội bộ\", () => pm.expect(pm.response.text()).to.not.match(/cost|123456|quantity|reserved|allocated|productCode|barcode|storeId|created|status|ACTIVE\"/i));"
            ]
          }
        }
      ]
    },
