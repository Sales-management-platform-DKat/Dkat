            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const d = pm.response.json().data;",
              "pm.test(\"inStock false, mọi chi nhánh OUT_OF_STOCK\", () => { pm.expect(d.inStock).to.eql(false); d.variants.forEach(v => v.branches.forEach(b => pm.expect(b.availability).to.eql(\"OUT_OF_STOCK\"))); });"
            ]
          }
        }
      ]
