        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const d = pm.response.json().data;",
              "pm.test(\"2 dòng, totalPages = ceil(total/2)\", () => { pm.expect(d.items.length).to.eql(2); pm.expect(d.totalPages).to.eql(Math.ceil(d.total / 2)); });",
              "pm.test(\"Có header giới hạn tốc độ\", () => { pm.expect(pm.response.headers.get(\"X-RateLimit-Limit\")).to.eql(\"60\"); pm.expect(Number(pm.response.headers.get(\"X-RateLimit-Remaining\"))).to.be.below(60); });"
            ]
          }
        }
