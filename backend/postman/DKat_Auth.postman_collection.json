                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"locked01\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 403\", () => pm.response.to.have.status(403));",
                  "pm.test(\"ACCOUNT_LOCKED\", () => pm.expect(pm.response.json().error.code).to.eql(\"ACCOUNT_LOCKED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.5 Thiếu trường",
