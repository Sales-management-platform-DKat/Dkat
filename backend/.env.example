# Runtime: development permits the local SQLite fallback; production requires a server database.
DKAT_ENV=development

# Production database (MySQL or TiDB). Keep credentials in the hosting environment's secret store.
DB_HOST=
DB_PORT=4000
DB_NAME=
DB_USER=
DB_PASSWORD=

# Optional development-only SQLite override. Production rejects SQLite.
# DKAT_DATABASE_URL=sqlite:///./dkat.db

DKAT_ADMIN_TOKEN=
DKAT_AUTH_SECRET_KEY=
DKAT_COOKIE_SECURE=auto
ALLOW_EMPLOYEE_STOCK=false
PREORDER_READY_DAYS=7
DKAT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Persistent directory for product uploads (relative paths use the backend directory).
DKAT_PRODUCT_IMAGE_DIR=uploads/products
