# ---- App ----
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dkat
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ---- Auth ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_HOURS=8
BCRYPT_ROUNDS=12

# ---- Public API (no login) ----
PUBLIC_RATE_LIMIT_PER_MINUTE=60

# ---- Audit (NFR-08) ----
CUSTOMER_ACCESS_LOG_FILE=logs/customer_access.log

# ---- Email via SMTP (FR-09.2) ----
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURITY=starttls (or 465 + ssl).
# SMTP_PASSWORD must be a Google App Password (Account > Security > 2-Step Verification > App passwords),
# never the account password. SMTP_FROM_EMAIL must be the same Gmail address as SMTP_USERNAME.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=DKat
SMTP_TIMEOUT_SECONDS=10
# Recipient of: python -m scripts.send_test_email
EMAIL_TEST_TO=

# ---- SMS via eSMS.vn (FR-09.1) ----
# ApiKey / SecretKey: eSMS dashboard (https://account.esms.vn) > Quan ly API.
# Trial accounts: keep ESMS_BRANDNAME=Baotrixemay; only the test template
# "<CODE> la ma xac minh dang ky Baotrixemay cua ban" can be sent (scripts/send_test_sms.py uses it).
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=Baotrixemay
ESMS_SMS_TYPE=2
ESMS_SANDBOX=false
ESMS_CALLBACK_URL=
SMS_UNICODE=false
SMS_MAX_PARTS=3
SMS_TIMEOUT_SECONDS=10
# Recipient of: python -m scripts.send_test_sms (team phone, 0xxxxxxxxx)
SMS_TEST_TO=

# ---- Pre-order notifications (FR-09.3, FR-09.4) ----
# Wait for the carrier outcome after eSMS accepted an SMS (refused -> fall back to email). 0 = do not wait.
NOTIFY_SMS_CONFIRM_SECONDS=30
NOTIFY_SMS_POLL_SECONDS=5
