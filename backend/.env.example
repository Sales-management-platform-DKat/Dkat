# Runtime: development permits the local SQLite fallback; production requires a server database.
DKAT_ENV=development

# Production database (MySQL or TiDB). Keep credentials in the hosting environment's secret store.
DB_HOST=
DB_PORT=4000
DB_NAME=
DB_USER=
DB_PASSWORD=
# verify (default, TiDB/production) | disabled (local MySQL 8 with its self-signed certificate)
DB_SSL_MODE=verify

# Optional development-only SQLite override. Production rejects SQLite.
# DKAT_DATABASE_URL=sqlite:///./dkat.db

DKAT_ADMIN_TOKEN=
DKAT_AUTH_SECRET_KEY=
DKAT_COOKIE_SECURE=auto
ALLOW_EMPLOYEE_STOCK=false
PREORDER_READY_DAYS=7
DKAT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Persistent directory for product uploads (relative paths use the backend directory).
DKAT_PRODUCT_IMAGE_DIR=uploads/products

# Pre-order notifications (FR-09). Leave empty to disable a channel: the attempt is recorded as
# FAILED / NOT_CONFIGURED and never breaks the business flow.
# Email over SMTP. Gmail: SMTP_HOST=smtp.gmail.com, port 587 starttls, a 16-character App Password
# (requires 2-step verification), SMTP_FROM_EMAIL must equal SMTP_USERNAME.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=DKat
# SMS via eSMS.vn. Trial accounts may only send registered templates (CodeResult 146 otherwise):
# the notification then falls back to email.
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=Baotrixemay
ESMS_SANDBOX=false
# Hotline shown in messages when the branch has no phone.
STORE_CONTACT_PHONE=
# Automatic re-send of FAILED notifications (every 5 minutes, at most 3 times per row).
NOTIFY_RETRY_ENABLED=true
NOTIFY_RETRY_INTERVAL_SECONDS=300
NOTIFY_MAX_RETRIES=3

# Public catalog /api/v1/public/* (no login): requests per minute per IP.
PUBLIC_RATE_LIMIT_PER_MINUTE=60
