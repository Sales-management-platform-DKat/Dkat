# ---- App ----
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dkat
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ---- Auth ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_HOURS=8
BCRYPT_ROUNDS=12

# ---- Public API (no login) ----
PUBLIC_RATE_LIMIT_PER_MINUTE=60

# ---- Audit (NFR-08) ----
CUSTOMER_ACCESS_LOG_FILE=logs/customer_access.log
